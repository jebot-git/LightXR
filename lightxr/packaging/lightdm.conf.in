[LightDM]
minimum-vt=1
run-directory=/run/lightxr/daemon
log-directory=/var/log/lightxr
cache-directory=/var/cache/lightxr
greeters-directory=@CMAKE_INSTALL_FULL_DATADIR@/xgreeters
sessions-directory=@session_dirs@
greeter-user=lightxr
[Seat:*]
greeter-session=lightxr
user-session=dome
session-wrapper=@CMAKE_INSTALL_FULL_LIBEXECDIR@/lightxr/lightxr-session
pam-service=lightxr
pam-autologin-service=lightxr-disabled-autologin
pam-greeter-service=lightxr-greeter
greeter-hide-users=false
greeter-allow-guest=false
allow-guest=false

[XDMCPServer]
enabled=false
[VNCServer]
enabled=false
